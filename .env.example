# Research and script generation.
ANTHROPIC_API_KEY=

# Narration uses Google Cloud Text-to-Speech, which authenticates through
# Application Default Credentials rather than a key in this file. Run once:
#
#   gcloud auth application-default login
#
# Or point this at a service-account key instead:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Concept art and thumbnails, when images.provider is set to gemini.
# GEMINI_API_KEY=

# Optional: override the SQLite location (default: work/tube_auto.db)
# TUBE_AUTO_DB=
